{
  "name": "@opcb/desktop",
  "productName": "OP-CB",
  "version": "0.7.1",
  "private": true,
  "description": "OP-CB desktop application: Electron main + preload + Vite/React renderer shell.",
  "license": "MIT",
  "homepage": "https://github.com/the-x1x1/OP-CB",
  "type": "module",
  "main": "dist/main/main.cjs",
  "desktopName": "opcb.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "OPCB_DEMO=1 vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "node scripts/build-main.mjs && vite build --config vite.config.ts",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc -p ../../tsconfig.json && tsc -p ../../tsconfig.renderer.json"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@cesium/engine": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@opcb/config": "workspace:*",
    "@opcb/core": "workspace:*",
    "@opcb/diagnostics": "workspace:*",
    "@opcb/ipc-contract": "workspace:*",
    "@opcb/provider-sdk": "workspace:*",
    "@opcb/render-cesium": "workspace:*",
    "@opcb/render-core": "workspace:*",
    "@opcb/render-maplibre": "workspace:*",
    "@opcb/runtime": "workspace:*",
    "@opcb/source-health": "workspace:*",
    "@opcb/ui": "workspace:*",
    "@opcb/updater": "workspace:*",
    "@opcb/world-model": "workspace:*",
    "cesium": "^1.145.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^3.0.0 || ^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.5"
  },
  "author": "OP-CB contributors"
}
