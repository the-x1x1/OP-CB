{
  "schema": "oneview.connector.v1",
  "id": "eccc-aqhi",
  "name": "Air quality, Canada (ECCC Air Quality Health Index)",
  "description": "The latest observed Air Quality Health Index at each of Environment and Climate Change Canada's ~120 AQHI stations: a health-risk scale of 1 to 10 and over (low 1–3, moderate 4–6, high 7–10, very high above 10) from ozone, nitrogen dioxide and fine particles, hourly. Not a US AQI, and read as what it is. Read every half hour.",
  "connector": "ogc-features",
  "objectType": "sensor",
  "categories": ["environment"],
  "endpoint": {
    "url": "https://api.weather.gc.ca/collections/aqhi-observations-realtime/items",
    "query": {
      "f": "json",
      "latest": "true",
      "limit": 500
    },
    "intervalSeconds": 1800,
    "timeoutSeconds": 30
  },
  "mapping": {
    "externalId": { "path": "properties.location_id", "transform": ["trim", "uppercase", "emptyToNone"] },
    "observedAt": { "path": "properties.observation_datetime", "transform": "isoTimestamp" },
    "position": { "geometry": "geometry" },
    "labels": {
      "name": { "path": "properties.location_name_en", "transform": ["trim", "emptyToNone"] }
    },
    "properties": {
      "sensorKind": { "literal": "air-quality" },
      "name": { "path": "properties.location_name_en", "transform": ["trim", "emptyToNone"] },
      "aqhi": { "path": "properties.aqhi", "transform": "number" },
      "stationId": { "path": "properties.location_id", "transform": ["trim", "uppercase"] },
      "observationType": { "path": "properties.observation_type", "transform": ["trim", "emptyToNone"] },
      "specialNotes": { "path": "properties.special_notes_en", "transform": ["trim", "emptyToNone"] }
    },
    "filter": [{ "path": "properties.latest", "equals": true }]
  },
  "freshness": {
    "liveSeconds": 7200,
    "recentSeconds": 21600,
    "expireSeconds": 86400
  },
  "sourceQuality": "authoritative",
  "attribution": {
    "text": "Data Source: Environment and Climate Change Canada",
    "url": "https://eccc-msc.github.io/open-data/licence/readme_en/"
  },
  "termsUrl": "https://eccc-msc.github.io/open-data/licence/readme_en/",
  "dataPolicy": {
    "cacheAllowed": true,
    "rawPayloadRetentionAllowed": true,
    "normalizedRetentionAllowed": true,
    "redistributionAllowed": true,
    "offlinePackAllowed": true,
    "exportAllowed": true,
    "commercialUseAllowed": true,
    "attributionRequired": true,
    "attributionText": "Data Source: Environment and Climate Change Canada",
    "termsUrl": "https://eccc-msc.github.io/open-data/licence/readme_en/"
  },
  "review": "commercially-reviewed",
  "enabled": true
}
