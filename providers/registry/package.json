{
  "name": "@opcb/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Provider registry: factory maps of every WorldProvider shipped with OP-CB (consumed by the runtime; never by UI or renderers).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opcb/connector-runtime": "workspace:*",
    "@opcb/connector-sdk": "workspace:*",
    "@opcb/provider-adsb-remote": "workspace:*",
    "@opcb/provider-ais": "workspace:*",
    "@opcb/provider-ais-local": "workspace:*",
    "@opcb/provider-cameras-local": "workspace:*",
    "@opcb/provider-cctv-public": "workspace:*",
    "@opcb/provider-celestrak": "workspace:*",
    "@opcb/provider-firms": "workspace:*",
    "@opcb/provider-infrastructure": "workspace:*",
    "@opcb/provider-meshtastic-local": "workspace:*",
    "@opcb/provider-nhc": "workspace:*",
    "@opcb/provider-nmea2000-local": "workspace:*",
    "@opcb/provider-purpleair-local": "workspace:*",
    "@opcb/provider-readsb-local": "workspace:*",
    "@opcb/provider-sdk": "workspace:*",
    "@opcb/provider-usgs": "workspace:*",
    "@opcb/provider-weather": "workspace:*",
    "@opcb/provider-weatherlink-local": "workspace:*"
  },
  "sideEffects": false
}
